# ---------------------------------------------------------------------------
# OccasioCart environment variables
# Copy this file to .env.local and fill in real values.
# Validated at startup via src/config/env.ts (Zod) — see that file for the schema.
# ---------------------------------------------------------------------------

# Runtime environment
NODE_ENV=development

# OpenAI (or any OpenAI-compatible provider, e.g. Groq/OpenRouter — set OPENAI_BASE_URL below)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: automatically retried once if the primary provider call fails (auth error,
# exhausted quota, rate limit, malformed response). Leave unset to disable fallback.
# OPENAI_FALLBACK_API_KEY=
# OPENAI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_FALLBACK_MODEL=openai/gpt-oss-20b:free

# ---------------------------------------------------------------------------
# Swiggy Instamart MCP (Builders Club) — OAuth 2.1 + PKCE, NOT a static API key.
# Endpoints below come from https://mcp.swiggy.com/.well-known/oauth-authorization-server
# ---------------------------------------------------------------------------

# The MCP tool-call endpoint itself
INSTAMART_MCP_SERVER_URL=https://mcp.swiggy.com/im

# OAuth endpoints
INSTAMART_MCP_AUTH_URL=https://mcp.swiggy.com/auth/authorize
INSTAMART_MCP_TOKEN_URL=https://mcp.swiggy.com/auth/token
INSTAMART_MCP_REGISTRATION_URL=https://mcp.swiggy.com/auth/register

# Obtained once via Dynamic Client Registration (RFC 7591) against
# INSTAMART_MCP_REGISTRATION_URL. Swiggy's DCR endpoint currently returns a fixed
# "swiggy-mcp" client_id (public PKCE client, no client_secret) regardless of client_name.
INSTAMART_MCP_CLIENT_ID=swiggy-mcp

# Must match a redirect URI registered via DCR. http://localhost is allowed for development.
INSTAMART_MCP_REDIRECT_URI=http://localhost:3000/api/instamart/auth/callback
